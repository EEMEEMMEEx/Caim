# MongoDB Atlas Connection String
# Replace <USERNAME> with your MongoDB Atlas database user username
MONGODB_URI=mongodb+srv://<USERNAME>:ILHR4j9r6lLdnTXh@slr.b6ih1xk.mongodb.net/caim?retryWrites=true&w=majority

# Stock-Flow webhook (CAIM -> Stock-Flow, integration plan Phase 2)
# HMAC-SHA256 shared secret for the "x-caim-signature" header; must equal Stock-Flow CAIM_WEBHOOK_SECRET.
# Leave empty to disable dispatching (closing a case still succeeds, a warning is logged instead).
CAIM_WEBHOOK_SECRET=
# Override only when testing against a non-production Stock-Flow endpoint
STOCKFLOW_WEBHOOK_URL=https://stockflowth.online/api/caim-webhook

# Inbound API key for Stock-Flow -> CAIM (CAIM <- Stock-Flow, integration plan section 5.1)
# Stock-Flow sends "Authorization: Bearer <CAIM_API_KEY>" to POST /api/tickets and the value must match
# CAIM_API_KEY in the Stock-Flow project. While this is empty, external ticket creation is rejected
# with HTTP 503 (the portal's own POST /api/claims is unaffected).
CAIM_API_KEY=
