# ==============================================================================
# CAIM - Equipment Claims & RMA Tracking System for Forth Corporation
# Environment variables
#
# วิธีใช้:
#   1) Local  : คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (หรือใช้ .env.local ก็ได้)
#               ทั้ง .env และ .env.local ถูก gitignore; ถ้ามีทั้งคู่ .env.local จะทับ .env
#               (ยกเว้นตอน NODE_ENV=test ที่ Next.js จะไม่โหลด .env.local)
#   2) Vercel : Settings -> Environment Variables ใส่ Key เดียวกันนี้ ทีละตัว
#               Type = Secret สำหรับค่าที่เป็นความลับ, Environments = Production
#               แล้ว Redeploy ทุกครั้งหลังแก้ค่า (env ไม่มีผลกับ deployment ที่รันอยู่)
#
# ห้าม commit ค่าจริงลงไฟล์นี้หรือไฟล์ใดใน repo - repo นี้เป็น public
# ตัวแปรที่โค้ดอ่านจริง:
#   MONGODB_URI           -> src/lib/mongodb.ts
#   CAIM_API_KEY          -> src/lib/auth/apiKeyAuth.ts
#   CAIM_WEBHOOK_SECRET   -> src/lib/webhooks/stockFlowWebhook.ts
#   STOCKFLOW_WEBHOOK_URL -> src/lib/webhooks/stockFlowWebhook.ts
# ==============================================================================

# ------------------------------------------------------------------------------
# 1) Database (ต้องมี - ถ้าไม่มี ระบบจะ fallback ไปเก็บที่ดิสก์ในเครื่องแทน MongoDB)
# ------------------------------------------------------------------------------
# MongoDB Atlas connection string
# ขอจาก: MongoDB Atlas -> Database -> Connect -> Drivers -> Copy connection string
# แล้วแทน <db_username> / <db_password> / <cluster-host> ด้วยค่าจริงของ cluster
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/caim?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2) Stock-Flow -> CAIM  (inbound, ต้องมีถ้าเปิดใช้ integration)
# ------------------------------------------------------------------------------
# ฝั่ง Stock-Flow แนบ header "Authorization: Bearer <CAIM_API_KEY>" ตอน POST /api/tickets
# ต้องเป็นค่าเดียวกันกับ CAIM_API_KEY ในโปรเจกต์ Vercel ของ Stock-Flow
# สร้างค่า (hex 64 ตัว): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ห้ามใช้ค่าเดียวกับ CAIM_WEBHOOK_SECRET
# ถ้าเว้นว่าง: POST /api/tickets ตอบ 503 ทุกครั้ง (พอร์ทัลยังใช้ POST /api/claims ได้ตามปกติ)
CAIM_API_KEY=

# ------------------------------------------------------------------------------
# 3) CAIM -> Stock-Flow  (outbound webhook, Integration Plan Phase 2)
# ------------------------------------------------------------------------------
# HMAC-SHA256 ของ body สำหรับ header "x-caim-signature" ตอนยิง event claim.closed
# ไปที่ POST /api/caim-webhook ของ Stock-Flow
# ต้องเป็นค่าเดียวกันกับ CAIM_WEBHOOK_SECRET ในโปรเจกต์ Stock-Flow
# สร้างค่า (hex 64 ตัว): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ถ้าเว้นว่าง: ปิดการยิง webhook (ปิดเคสยังสำเร็จเสมอ แต่จะมี log เตือน)
CAIM_WEBHOOK_SECRET=

# ปลายทางของ webhook - ไม่บังคับ (ถ้าเว้นว่างโค้ดจะใช้ค่า default ในซอร์ส)
# ใส่ URL เต็ม ห้ามมี "/" ปิดท้าย ใช้เมื่อทดสอบกับ staging หรือ tunnel ในเครื่องเท่านั้น
STOCKFLOW_WEBHOOK_URL=https://stockflowth.online/api/caim-webhook
